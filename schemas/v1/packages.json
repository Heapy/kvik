{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kvik.dev/schemas/v1/packages.json",
  "$defs": {
    "digest": {
      "type": "object",
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "hash",
        "sizeBytes"
      ],
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 4096
        },
        "url": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "id",
        "url"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 4096
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "url",
        "digest"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "coordinate": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$(?![\\s\\S])",
          "maxLength": 1024
        },
        "variant": {
          "type": "string",
          "maxLength": 4096
        },
        "repository": {
          "type": "string",
          "maxLength": 4096
        },
        "url": {
          "type": "string",
          "maxLength": 4096
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "coordinate",
        "variant",
        "repository",
        "url",
        "digest"
      ],
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "properties": {
        "platform": {
          "enum": [
            "jvm",
            "macosArm64",
            "linuxX64",
            "iosArm64",
            "iosSimulatorArm64",
            "js",
            "wasmJs",
            "common"
          ]
        },
        "usage": {
          "type": "string",
          "maxLength": 4096
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "required": [
        "platform",
        "usage",
        "attributes"
      ],
      "additionalProperties": false
    },
    "domain": {
      "oneOf": [
        {
          "$ref": "#/$defs/moduleDomain"
        },
        {
          "$ref": "#/$defs/scriptDomain"
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 4096
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        },
        "source": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "source"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "maxLength": 4096
        },
        "url": {
          "type": "string",
          "maxLength": 4096
        },
        "kind": {
          "enum": [
            "metadata",
            "artifact"
          ]
        },
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "cache": {
          "enum": [
            "network",
            "cache",
            "locked",
            "none"
          ]
        },
        "status": {
          "enum": [
            "found",
            "not-found",
            "missing",
            "corrupt",
            "error"
          ]
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "missing",
            "indeterminate"
          ]
        },
        "latest": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "release": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "lastUpdated": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "repository",
        "url",
        "kind",
        "digest",
        "observedAt",
        "cache",
        "status",
        "freshness",
        "latest",
        "release",
        "lastUpdated"
      ],
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "properties": {
        "coordinate": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$(?![\\s\\S])",
          "maxLength": 1024
        },
        "semantics": {
          "enum": [
            "requires",
            "prefers",
            "pom-effective",
            "redirect",
            "constraint",
            "explicit-exclusion",
            "metadata-exclusion"
          ]
        }
      },
      "required": [
        "coordinate",
        "semantics"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 4096
        },
        "coordinate": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$(?![\\s\\S])",
          "maxLength": 1024
        },
        "platform": {
          "type": "boolean"
        },
        "expanded": {
          "type": "boolean"
        },
        "variant": {
          "type": "string",
          "maxLength": 4096
        },
        "repository": {
          "type": "string",
          "maxLength": 4096
        },
        "metadata": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metadata"
          },
          "maxItems": 32
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "maxItems": 32
        }
      },
      "required": [
        "id",
        "coordinate",
        "platform",
        "expanded",
        "variant",
        "repository",
        "metadata",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 4096
        },
        "target": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "dependency",
            "redirect",
            "constraint",
            "excluded"
          ]
        },
        "requirement": {
          "$ref": "#/$defs/requirement"
        },
        "selected": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$(?![\\s\\S])",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "transitive": {
          "type": "boolean"
        },
        "exclusion": {
          "type": "object",
          "properties": {
            "rule": {
              "$ref": "#/$defs/metadataExclusion"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          },
          "required": [
            "rule",
            "digest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "source",
        "target",
        "kind",
        "requirement",
        "selected",
        "transitive"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "excluded"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "type": "null"
              },
              "selected": {
                "type": "null"
              },
              "transitive": {
                "const": false
              },
              "requirement": {
                "properties": {
                  "semantics": {
                    "enum": [
                      "explicit-exclusion",
                      "metadata-exclusion"
                    ]
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "requirement": {
                      "properties": {
                        "semantics": {
                          "const": "explicit-exclusion"
                        }
                      }
                    }
                  }
                },
                "then": {
                  "required": [
                    "exclusion"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "exclusion"
                    ]
                  }
                }
              }
            ]
          },
          "else": {
            "not": {
              "required": [
                "exclusion"
              ]
            },
            "properties": {
              "requirement": {
                "properties": {
                  "semantics": {
                    "enum": [
                      "requires",
                      "prefers",
                      "pom-effective",
                      "redirect",
                      "constraint"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "root": {
      "type": "object",
      "properties": {
        "requested": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$(?![\\s\\S])",
          "maxLength": 1024
        },
        "node": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "requested",
        "node"
      ],
      "additionalProperties": false
    },
    "path": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$(?![\\s\\S])",
          "maxLength": 1024
        },
        "node": {
          "type": "string",
          "maxLength": 4096
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 1024
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "maxItems": 1024
        }
      },
      "required": [
        "root",
        "node",
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "properties": {
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/root"
          },
          "maxItems": 256
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "maxItems": 1024
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          },
          "maxItems": 8192
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "maxItems": 4096
        },
        "pathPolicy": {
          "enum": [
            "shortest-per-root-node"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "artifactVerification": {
          "enum": [
            "verified"
          ]
        }
      },
      "required": [
        "variant",
        "roots",
        "nodes",
        "edges",
        "paths",
        "pathPolicy",
        "truncated",
        "artifactVerification"
      ],
      "additionalProperties": false
    },
    "version": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 4096
        },
        "channel": {
          "enum": [
            "stable",
            "prerelease",
            "unclassified"
          ]
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32
        }
      },
      "required": [
        "version",
        "channel",
        "repositories"
      ],
      "additionalProperties": false
    },
    "declaration": {
      "oneOf": [
        {
          "$ref": "#/$defs/moduleDeclaration"
        },
        {
          "$ref": "#/$defs/scriptDeclaration"
        }
      ]
    },
    "scopedGraph": {
      "type": "object",
      "properties": {
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "graph": {
          "$ref": "#/$defs/graph"
        }
      },
      "required": [
        "domain",
        "graph"
      ],
      "additionalProperties": false
    },
    "versionQuery": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "maxLength": 4096
        },
        "coordinate": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$(?![\\s\\S])",
          "maxLength": 512
        },
        "repositories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repository"
          },
          "maxItems": 32
        },
        "channel": {
          "enum": [
            "all",
            "stable",
            "prerelease"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "enum": [
            "cache",
            "refresh",
            "offline"
          ]
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      },
      "required": [
        "project",
        "coordinate",
        "repositories",
        "channel",
        "limit",
        "cursor",
        "mode"
      ],
      "additionalProperties": false
    },
    "packageQuery": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "maxLength": 4096
        },
        "coordinate": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$(?![\\s\\S])",
          "maxLength": 1024
        },
        "repositories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repository"
          },
          "maxItems": 32
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "pins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$(?![\\s\\S])",
            "maxLength": 1024
          },
          "maxItems": 256
        },
        "mode": {
          "enum": [
            "cache",
            "refresh",
            "offline"
          ]
        }
      },
      "required": [
        "project",
        "coordinate",
        "repositories",
        "variant",
        "pins",
        "mode"
      ],
      "additionalProperties": false
    },
    "projectQuery": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "maxLength": 4096
        },
        "lock": {
          "type": "string",
          "maxLength": 4096
        },
        "store": {
          "type": "string",
          "maxLength": 4096
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 1024
        },
        "targets": {
          "type": "array",
          "items": {
            "enum": [
              "jvm",
              "macosArm64",
              "linuxX64",
              "iosArm64",
              "iosSimulatorArm64",
              "js",
              "wasmJs"
            ]
          },
          "maxItems": 7
        },
        "compilation": {
          "anyOf": [
            {
              "enum": [
                "main",
                "test",
                "script"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "anyOf": [
            {
              "enum": [
                "java-api",
                "java-runtime",
                "kotlin-api",
                "kotlin-runtime"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "scripts": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$(?![\\s\\S])"
          },
          "maxItems": 256
        }
      },
      "required": [
        "project",
        "lock",
        "store",
        "modules",
        "targets",
        "compilation",
        "usage"
      ],
      "additionalProperties": false
    },
    "moduleDomain": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "maxLength": 4096
        },
        "target": {
          "enum": [
            "jvm",
            "macosArm64",
            "linuxX64",
            "iosArm64",
            "iosSimulatorArm64",
            "js",
            "wasmJs"
          ]
        },
        "compilation": {
          "enum": [
            "main",
            "test"
          ]
        },
        "usage": {
          "enum": [
            "java-api",
            "java-runtime",
            "kotlin-api",
            "kotlin-runtime"
          ]
        },
        "purpose": {
          "enum": [
            "dependencies",
            "compiler-plugin",
            "ksp-runtime",
            "symbol-processor",
            "sqldelight-compiler"
          ]
        },
        "pluginId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$(?![\\s\\S])"
        }
      },
      "required": [
        "module",
        "target",
        "compilation",
        "usage",
        "purpose"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "sqldelight-compiler"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "const": "jvm"
              },
              "compilation": {
                "const": "main"
              },
              "usage": {
                "const": "java-runtime"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "pluginId"
            ]
          },
          "then": {
            "properties": {
              "purpose": {
                "const": "compiler-plugin"
              },
              "usage": {
                "const": "java-runtime"
              }
            }
          }
        }
      ]
    },
    "scriptDomain": {
      "type": "object",
      "properties": {
        "script": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$(?![\\s\\S])"
        },
        "target": {
          "const": "jvm"
        },
        "compilation": {
          "const": "script"
        },
        "usage": {
          "enum": [
            "java-api",
            "java-runtime"
          ]
        },
        "purpose": {
          "enum": [
            "dependencies",
            "compiler-plugin"
          ]
        },
        "pluginId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$(?![\\s\\S])"
        }
      },
      "required": [
        "script",
        "target",
        "compilation",
        "usage",
        "purpose"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "compiler-plugin"
              }
            }
          },
          "then": {
            "properties": {
              "usage": {
                "const": "java-runtime"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "pluginId"
            ]
          },
          "then": {
            "properties": {
              "purpose": {
                "const": "compiler-plugin"
              },
              "usage": {
                "const": "java-runtime"
              }
            }
          }
        }
      ]
    },
    "moduleDeclaration": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "maxLength": 4096
        },
        "sourceSet": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "external",
            "module",
            "compiler-plugin",
            "ksp-runtime",
            "symbol-processor",
            "sqldelight-compiler"
          ]
        },
        "coordinate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$(?![\\s\\S])",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencyModule": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "enum": [
            "compile",
            "runtime"
          ]
        },
        "exported": {
          "type": "boolean"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32
        },
        "compilations": {
          "type": "array",
          "items": {
            "enum": [
              "main",
              "test"
            ]
          },
          "maxItems": 2
        },
        "pluginId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$(?![\\s\\S])"
        },
        "compilerVersion": {
          "const": "2.4.20"
        }
      },
      "required": [
        "module",
        "sourceSet",
        "kind",
        "coordinate",
        "dependencyModule",
        "scope",
        "exported",
        "targets",
