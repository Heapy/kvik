{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kvik.dev/schemas/v1/session.json",
  "$defs": {
    "control": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+(?![\\s\\S])"
        },
        "command": {
          "enum": [
            "r",
            "t",
            "q",
            "?",
            "status"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "command"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "session-started",
            "control",
            "diagnostic",
            "inputs-observed",
            "operation-started",
            "operation-finished",
            "closing",
            "session-finished",
            "composition-observed",
            "rebuild-started",
            "rebuild-finished",
            "session-restarting",
            "replacement-checked",
            "application-preparing",
            "application-ready",
            "application-activating",
            "application-started",
            "application-stale",
            "application-finished"
          ]
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "schemaVersion",
        "sessionId",
        "sequence",
        "type",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "session-started"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "control": {
                    "enum": [
                      "jsonl",
                      "lines",
                      "keys"
                    ]
                  },
                  "directory": {
                    "type": "string"
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "limitations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "previousSessionDirectory": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "composition": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/digest"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "control",
                  "directory",
                  "capabilities",
                  "limitations",
                  "previousSessionDirectory",
                  "composition"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "control"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "requestId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "command": {
                    "enum": [
                      "r",
                      "t",
                      "q",
                      "?",
                      "status"
                    ]
                  },
                  "active": {
                    "enum": [
                      "build",
                      "test",
                      null
                    ]
                  },
                  "pending": {
                    "enum": [
                      "build",
                      "test",
                      null,
                      "application"
                    ]
                  },
                  "help": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "compositionReady": {
                    "type": "boolean"
                  },
                  "application": {
                    "$ref": "#/$defs/applicationStatus"
                  },
                  "pendingIntents": {
                    "type": "array",
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "test",
                        "application"
                      ]
                    }
                  }
                },
                "required": [
                  "requestId",
                  "command",
                  "active",
                  "pending",
                  "help",
                  "compositionReady"
                ],
                "additionalProperties": false,
                "dependentRequired": {
                  "application": [
                    "pendingIntents"
                  ],
                  "pendingIntents": [
                    "application"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "diagnostic"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "code": {
                    "enum": [
                      "KVIK_SESSION_CONTROL",
                      "KVIK_SESSION_RESTART",
                      "KVIK_SESSION_APPLICATION",
                      "KVIK_SESSION_OBSERVATION"
                    ]
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "inputs-observed"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "revision": {
                    "type": "integer"
                  },
                  "available": {
                    "type": "boolean"
                  },
                  "fingerprint": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "hash": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "sizeBytes": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "hash",
                          "sizeBytes"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "scope": {
                    "const": "project-inputs-and-tools-document-only"
                  }
                },
                "required": [
                  "revision",
                  "available",
                  "fingerprint",
                  "scope"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "operation-started"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "generation": {
                    "type": "integer"
                  },
                  "operation": {
                    "enum": [
                      "build",
                      "test"
                    ]
                  },
                  "evidenceDirectory": {
                    "type": "string"
                  }
                },
                "required": [
                  "generation",
                  "operation",
                  "evidenceDirectory"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "operation-finished"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "generation": {
                    "type": "integer"
                  },
                  "operation": {
                    "enum": [
                      "build",
                      "test"
                    ]
                  },
                  "exitCode": {
                    "type": "integer"
                  },
                  "cancelled": {
                    "type": "boolean"
                  },
                  "timedOut": {
                    "type": "boolean"
                  },
                  "inputsChangedSinceStart": {
                    "type": "boolean"
                  },
                  "evidenceDirectory": {
                    "type": "string"
                  }
                },
                "required": [
                  "generation",
                  "operation",
                  "exitCode",
                  "cancelled",
                  "timedOut",
                  "inputsChangedSinceStart",
                  "evidenceDirectory"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "closing"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "session-finished"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "composition-observed"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "composition": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/digest"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "state": {
                    "enum": [
                      "current",
                      "stale",
                      "unavailable"
                    ]
                  },
                  "evidenceDirectory": {
                    "type": "string"
                  }
                },
                "required": [
                  "composition",
                  "state",
                  "evidenceDirectory"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rebuild-started"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "composition": {
                    "$ref": "#/$defs/digest"
                  },
                  "evidenceDirectory": {
                    "type": "string"
                  }
                },
                "required": [
                  "composition",
                  "evidenceDirectory"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rebuild-finished"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "composition": {
                    "$ref": "#/$defs/digest"
                  },
                  "exitCode": {
                    "type": "integer"
                  },
                  "cancelled": {
                    "type": "boolean"
                  },
                  "timedOut": {
                    "type": "boolean"
                  },
                  "accepted": {
                    "type": "boolean"
                  },
                  "error": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidenceDirectory": {
                    "type": "string"
                  }
                },
                "required": [
                  "composition",
                  "exitCode",
                  "cancelled",
                  "timedOut",
                  "accepted",
                  "error",
                  "evidenceDirectory"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "session-restarting"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "composition": {
                    "$ref": "#/$defs/digest"
                  },
                  "runtime": {
                    "type": "string"
                  },
                  "nextSessionDirectory": {
                    "type": "string"
                  }
                },
                "required": [
                  "composition",
                  "runtime",
                  "nextSessionDirectory"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "replacement-checked"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "composition": {
                    "$ref": "#/$defs/digest"
                  },
                  "compatible": {
                    "type": "boolean"
                  },
                  "error": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidenceDirectory": {
                    "type": "string"
                  }
                },
                "required": [
                  "composition",
                  "compatible",
                  "error",
                  "evidenceDirectory"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "application-preparing"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "composition": {
                    "$ref": "#/$defs/digest"
                  },
                  "module": {
                    "type": "string"
                  },
                  "target": {
                    "enum": [
                      "jvm",
                      "macosArm64"
                    ]
                  },
                  "evidenceDirectory": {
                    "type": "string"
                  }
                },
                "required": [
                  "generation",
                  "revision",
                  "composition",
                  "module",
                  "target",
                  "evidenceDirectory"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "application-ready"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "composition": {
                    "$ref": "#/$defs/digest"
                  },
                  "module": {
                    "type": "string"
                  },
                  "target": {
                    "enum": [
                      "jvm",
                      "macosArm64"
                    ]
                  },
                  "evidenceDirectory": {
                    "type": "string"
                  },
                  "ready": {
                    "$ref": "contracts.json#/$defs/applicationReady"
                  }
                },
                "required": [
                  "generation",
                  "revision",
                  "composition",
                  "module",
                  "target",
                  "evidenceDirectory",
                  "ready"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "application-activating"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "composition": {
                    "$ref": "#/$defs/digest"
                  },
                  "module": {
                    "type": "string"
                  },
                  "target": {
                    "enum": [
                      "jvm",
                      "macosArm64"
                    ]
                  },
                  "evidenceDirectory": {
                    "type": "string"
                  }
                },
                "required": [
                  "generation",
                  "revision",
                  "composition",
                  "module",
                  "target",
                  "evidenceDirectory"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "application-started"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "composition": {
                    "$ref": "#/$defs/digest"
                  },
                  "module": {
                    "type": "string"
                  },
                  "target": {
                    "enum": [
                      "jvm",
                      "macosArm64"
                    ]
                  },
                  "evidenceDirectory": {
                    "type": "string"
                  },
                  "started": {
                    "$ref": "contracts.json#/$defs/applicationStarted"
                  }
                },
                "required": [
                  "generation",
                  "revision",
                  "composition",
                  "module",
                  "target",
                  "evidenceDirectory",
                  "started"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "application-stale"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "composition": {
                    "$ref": "#/$defs/digest"
                  },
                  "module": {
                    "type": "string"
                  },
                  "target": {
                    "enum": [
                      "jvm",
                      "macosArm64"
                    ]
                  },
                  "evidenceDirectory": {
                    "type": "string"
                  }
                },
                "required": [
                  "generation",
                  "revision",
                  "composition",
                  "module",
                  "target",
                  "evidenceDirectory"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "application-finished"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "composition": {
                    "$ref": "#/$defs/digest"
                  },
                  "module": {
                    "type": "string"
                  },
                  "target": {
                    "enum": [
                      "jvm",
                      "macosArm64"
                    ]
                  },
                  "evidenceDirectory": {
                    "type": "string"
                  },
                  "exitCode": {
                    "type": "integer"
                  },
                  "cancelled": {
                    "type": "boolean"
                  },
                  "timedOut": {
                    "type": "boolean"
                  },
                  "started": {
                    "type": "boolean"
                  },
                  "stale": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "generation",
                  "revision",
                  "composition",
                  "module",
                  "target",
                  "evidenceDirectory",
                  "exitCode",
                  "cancelled",
                  "timedOut",
                  "started",
                  "stale"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "digest": {
      "type": "object",
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "hash",
        "sizeBytes"
      ],
      "additionalProperties": false
    },
    "terminalLease": {
      "description": "Invocation-local macOS ARM64 ABI-bound lease; C boundary validates owner, direct helper child, pipe and TTY identities, challenge and termios backup.",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "platform": {
          "const": "macos-arm64"
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^(?:[0-9a-f]{2})+(?![\\s\\S])"
        }
      },
      "required": [
        "schemaVersion",
        "platform",
        "state"
      ],
      "additionalProperties": false
    },
    "resumeV1": {
      "description": "UTF-8 representation bounded to 128 KiB; digest is carried in literal exec argv. Trusted invocation-local state.",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*(?![\\s\\S])"
        },
        "previousDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*(?![\\s\\S])"
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*(?![\\s\\S])"
        },
        "arguments": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*(?![\\s\\S])"
          }
        },
        "jsonControls": {
          "type": "boolean"
        },
        "watchMillis": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "pending": {
          "enum": [
            "build",
            "test"
          ]
        },
        "watched": {
          "enum": [
            "build",
            "test"
          ]
        },
        "partialInput": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "not": {
              "const": 10
            }
          }
        },
        "launch": {
          "$ref": "bootstrap-launch.json#/$defs/launch"
        }
      },
      "required": [
        "schemaVersion",
        "directory",
        "previousDirectory",
        "workingDirectory",
        "arguments",
        "jsonControls",
        "watchMillis",
        "pending",
        "watched",
        "partialInput",
        "launch"
      ],
      "additionalProperties": false
    },
    "resumeV2": {
      "description": "UTF-8 representation bounded to 128 KiB; digest is carried in literal exec argv. Trusted invocation-local state.",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*(?![\\s\\S])"
        },
        "previousDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*(?![\\s\\S])"
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*(?![\\s\\S])"
        },
        "arguments": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*(?![\\s\\S])"
          }
        },
        "jsonControls": {
          "const": false
        },
        "watchMillis": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "pending": {
          "enum": [
            "build",
            "test"
          ]
        },
        "watched": {
          "enum": [
            "build",
            "test"
          ]
        },
        "partialInput": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "not": {
              "const": 10
            }
          }
        },
        "launch": {
          "$ref": "bootstrap-launch.json#/$defs/launch"
        },
        "terminalLease": {
          "$ref": "#/$defs/terminalLease"
        }
      },
      "required": [
        "schemaVersion",
        "directory",
        "previousDirectory",
        "workingDirectory",
        "arguments",
        "jsonControls",
        "watchMillis",
        "pending",
        "watched",
        "partialInput",
        "launch",
        "terminalLease"
      ],
      "additionalProperties": false
    },
    "resume": {
      "oneOf": [
        {
          "$ref": "#/$defs/resumeV1"
        },
        {
          "$ref": "#/$defs/resumeV2"
        },
        {
          "$ref": "#/$defs/resumeV3"
        }
      ]
    },
    "sessionCapabilities": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "composition": {
          "$ref": "#/$defs/digest"
        },
        "runtime": {
          "type": "string"
        },
        "resumeVersions": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "terminalLease": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "platform": {
              "const": "macos-arm64"
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            }
          },
          "required": [
            "schemaVersion",
            "platform",
            "sizeBytes"
          ],
          "additionalProperties": false
        },
        "processOwnershipVersion": {
          "const": 1
        }
      },
      "required": [
        "schemaVersion",
        "composition",
        "runtime",
        "resumeVersions",
        "terminalLease"
      ],
      "additionalProperties": false
    },
    "resumeV3": {
      "description": "UTF-8 representation bounded to 128 KiB; digest is carried in literal exec argv. Trusted invocation-local state.",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*(?![\\s\\S])"
        },
        "previousDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*(?![\\s\\S])"
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*(?![\\s\\S])"
        },
        "arguments": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*(?![\\s\\S])"
          }
        },
        "jsonControls": {
          "type": "boolean"
        },
        "watchMillis": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "pending": {
          "enum": [
            "test",
            "application"
          ]
        },
        "watched": {
          "const": "application"
        },
        "partialInput": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "not": {
              "const": 10
            }
          }
        },
        "launch": {
          "$ref": "bootstrap-launch.json#/$defs/launch",
          "required": [
            "processOwnershipVersion"
          ]
        },
        "mode": {
          "const": "application"
        },
        "pendingIntents": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "test",
              "application"
            ]
          }
        },
        "preparedApplication": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "contracts.json#/$defs/applicationReady"
            }
          ]
        },
        "applicationModule": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*(?![\\s\\S])"
        },
        "applicationTarget": {
          "enum": [
            "jvm",
            "macosArm64"
          ]
        },
        "terminalLease": {
          "$ref": "#/$defs/terminalLease"
        }
      },
      "required": [
        "schemaVersion",
        "directory",
        "previousDirectory",
        "workingDirectory",
        "arguments",
        "jsonControls",
        "watchMillis",
        "pending",
        "watched",
        "partialInput",
        "launch",
        "mode",
        "pendingIntents",
        "preparedApplication",
        "applicationModule",
        "applicationTarget"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "terminalLease"
            ]
          },
          "then": {
            "properties": {
              "jsonControls": {
                "const": false
              },
              "partialInput": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "applicationStatus": {
      "type": "object",
      "properties": {
        "active": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "generation": {
                  "type": "integer",
                  "minimum": 1
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "composition": {
                  "$ref": "#/$defs/digest"
                },
                "module": {
                  "type": "string"
                },
                "target": {
                  "enum": [
                    "jvm",
                    "macosArm64"
                  ]
                },
                "evidenceDirectory": {
                  "type": "string"
                },
                "stale": {
                  "type": "boolean"
                }
              },
              "required": [
                "generation",
                "revision",
                "composition",
                "module",
                "target",
                "evidenceDirectory",
                "stale"
              ],
              "additionalProperties": false
            }
          ]
        },
        "candidate": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "generation": {
                  "type": "integer",
                  "minimum": 1
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "composition": {
                  "$ref": "#/$defs/digest"
                },
                "module": {
                  "type": "string"
                },
                "target": {
                  "enum": [
                    "jvm",
                    "macosArm64"
                  ]
                },
                "evidenceDirectory": {
                  "type": "string"
                },
                "phase": {
                  "enum": [
                    "preparing",
                    "ready",
                    "waiting-for-old-cleanup",
                    "starting",
                    "cancelling"
                  ]
                }
              },
              "required": [
                "generation",
                "revision",
                "composition",
                "module",
                "target",
                "evidenceDirectory",
                "phase"
              ],
              "additionalProperties": false
            }
          ]
        },
        "handoffReady": {
          "type": "boolean"
        }
      },
      "required": [
        "active",
        "candidate",
        "handoffReady"
      ],
      "additionalProperties": false
    }
  }
}
