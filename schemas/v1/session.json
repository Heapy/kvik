{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kvik.dev/schemas/v1/session.json",
  "$defs": {
    "control": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+(?![\\s\\S])"
        },
        "command": {
          "enum": [
            "r",
            "t",
            "q",
            "?",
            "status"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "command"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "session-started",
            "control",
            "diagnostic",
            "inputs-observed",
            "operation-started",
            "operation-finished",
            "closing",
            "session-finished",
            "composition-observed",
            "rebuild-started",
            "rebuild-finished",
            "session-restarting"
          ]
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "schemaVersion",
        "sessionId",
        "sequence",
        "type",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "session-started"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "control": {
                    "enum": [
                      "jsonl",
                      "lines"
                    ]
                  },
                  "directory": {
                    "type": "string"
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "limitations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "previousSessionDirectory": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "composition": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/digest"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "control",
                  "directory",
                  "capabilities",
                  "limitations",
                  "previousSessionDirectory",
                  "composition"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "control"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "requestId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "command": {
                    "enum": [
                      "r",
                      "t",
                      "q",
                      "?",
                      "status"
                    ]
                  },
                  "active": {
                    "enum": [
                      "build",
                      "test",
                      null
                    ]
                  },
                  "pending": {
                    "enum": [
                      "build",
                      "test",
                      null
                    ]
                  },
                  "help": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "compositionReady": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "requestId",
                  "command",
                  "active",
                  "pending",
                  "help",
                  "compositionReady"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "diagnostic"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "code": {
                    "enum": [
                      "KVIK_SESSION_CONTROL",
                      "KVIK_SESSION_RESTART"
                    ]
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "inputs-observed"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "revision": {
                    "type": "integer"
                  },
                  "available": {
                    "type": "boolean"
                  },
                  "fingerprint": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "hash": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "sizeBytes": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "hash",
                          "sizeBytes"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "scope": {
                    "const": "project-inputs-and-tools-document-only"
                  }
                },
                "required": [
                  "revision",
                  "available",
                  "fingerprint",
                  "scope"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "operation-started"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "generation": {
                    "type": "integer"
                  },
                  "operation": {
                    "enum": [
                      "build",
                      "test"
                    ]
                  },
                  "evidenceDirectory": {
                    "type": "string"
                  }
                },
                "required": [
                  "generation",
                  "operation",
                  "evidenceDirectory"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "operation-finished"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "generation": {
                    "type": "integer"
                  },
                  "operation": {
                    "enum": [
                      "build",
                      "test"
                    ]
                  },
                  "exitCode": {
                    "type": "integer"
                  },
                  "cancelled": {
                    "type": "boolean"
                  },
                  "timedOut": {
                    "type": "boolean"
                  },
                  "inputsChangedSinceStart": {
                    "type": "boolean"
                  },
                  "evidenceDirectory": {
                    "type": "string"
                  }
                },
                "required": [
                  "generation",
                  "operation",
                  "exitCode",
                  "cancelled",
                  "timedOut",
                  "inputsChangedSinceStart",
                  "evidenceDirectory"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "closing"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "session-finished"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "composition-observed"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "composition": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/digest"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "state": {
                    "enum": [
                      "current",
                      "stale",
                      "unavailable"
                    ]
                  },
                  "evidenceDirectory": {
                    "type": "string"
                  }
                },
                "required": [
                  "composition",
                  "state",
                  "evidenceDirectory"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rebuild-started"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "composition": {
                    "$ref": "#/$defs/digest"
                  },
                  "evidenceDirectory": {
                    "type": "string"
                  }
                },
                "required": [
                  "composition",
                  "evidenceDirectory"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rebuild-finished"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "composition": {
                    "$ref": "#/$defs/digest"
                  },
                  "exitCode": {
                    "type": "integer"
                  },
                  "cancelled": {
                    "type": "boolean"
                  },
                  "timedOut": {
                    "type": "boolean"
                  },
                  "accepted": {
                    "type": "boolean"
                  },
                  "error": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidenceDirectory": {
                    "type": "string"
                  }
                },
                "required": [
                  "composition",
                  "exitCode",
                  "cancelled",
                  "timedOut",
                  "accepted",
                  "error",
                  "evidenceDirectory"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "session-restarting"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "composition": {
                    "$ref": "#/$defs/digest"
                  },
                  "runtime": {
                    "type": "string"
                  },
                  "nextSessionDirectory": {
                    "type": "string"
                  }
                },
                "required": [
                  "composition",
                  "runtime",
                  "nextSessionDirectory"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "digest": {
      "type": "object",
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "hash",
        "sizeBytes"
      ],
      "additionalProperties": false
    },
    "resume": {
      "description": "UTF-8 representation bounded to 128 KiB; digest is carried in literal exec argv. Trusted invocation-local state.",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*(?![\\s\\S])"
        },
        "previousDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*(?![\\s\\S])"
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*(?![\\s\\S])"
        },
        "arguments": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*(?![\\s\\S])"
          }
        },
        "jsonControls": {
          "type": "boolean"
        },
        "watchMillis": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "pending": {
          "enum": [
            "build",
            "test"
          ]
        },
        "watched": {
          "enum": [
            "build",
            "test"
          ]
        },
        "partialInput": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "not": {
              "const": 10
            }
          }
        },
        "launch": {
          "$ref": "bootstrap-launch.json#/$defs/launch"
        }
      },
      "required": [
        "schemaVersion",
        "directory",
        "previousDirectory",
        "workingDirectory",
        "arguments",
        "jsonControls",
        "watchMillis",
        "pending",
        "watched",
        "partialInput",
        "launch"
      ],
      "additionalProperties": false
    }
  }
}
